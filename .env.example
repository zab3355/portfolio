# ─── Firebase (Realtime Database) ────────────────────────────────
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_MEASUREMENT_ID=

# ─── Backend API (production only — leave blank for localhost) ────
REACT_APP_API_URL=

REACT_APP_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ─── EmailJS — contact form email notification ────────────────────
# Sign up at https://www.emailjs.com/ (free: 200 emails/month)
# 1. Connect your Gmail account as a Service
# 2. Create an Email Template — add {{from_name}}, {{from_email}}, {{subject}}, {{message}}
#    Set the "To Email" in the template to your email address (never hard-code it here)
# 3. Copy the Service ID, Template ID, and Public Key below
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# ─── Backend SMTP (server-side only — not used by React frontend) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=me@zabrown.com
CONTACT_TO_EMAIL=me@zabrown.com
