# Dockerfile.ui

# ============================
# Stage 1: Build React (CRA)
# ============================
FROM node:20-alpine AS build

WORKDIR /app

# API URL varies per environment; Firebase config lives in .env.production (public values)
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ARG REACT_APP_TURNSTILE_SITE_KEY
ENV REACT_APP_TURNSTILE_SITE_KEY=$REACT_APP_TURNSTILE_SITE_KEY
ENV DISABLE_ESLINT_PLUGIN=true

# Install frontend deps
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

# Copy source
COPY . .

RUN npm run build

# ============================
# Stage 2: Serve with nginx
# ============================
FROM nginx:alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
